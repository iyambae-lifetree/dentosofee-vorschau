---
// Kauen, Schlucken und Atmen als drei Kreise, die zueinanderfinden (Einleitung Dentosophie).
// Ersetzt im Seitenkopf den Platzhalter „Foto folgt“. TODO: Balancer-Foto nach dem Shooting an anderer Stelle zeigen.
---
<figure class="drei-funktionen">
  <svg viewBox="0 0 400 400" role="img" aria-labelledby="drei-titel">
    <title id="drei-titel">Drei Funktionen im Mundraum: Kauen, Schlucken und Atmen, in der Mitte der Balancer</title>
    <g class="atmen-ganz">
      <g class="kreis k-kauen"><circle cx="200" cy="148" r="104" /></g>
      <g class="kreis k-schlucken"><circle cx="146" cy="242" r="104" /></g>
      <g class="kreis k-atmen"><circle cx="254" cy="242" r="104" /></g>
      <g class="beschriftung" aria-hidden="true">
        <text x="200" y="96">Kauen</text>
        <text x="100" y="296">Schlucken</text>
        <text x="298" y="296">Atmen</text>
        <text class="mitte" x="200" y="216">Balancer</text>
      </g>
    </g>
  </svg>
</figure>

<style>
  .drei-funktionen { margin: 0; max-width: 460px; margin-inline: auto; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  circle { stroke: var(--ink); stroke-opacity: .35; stroke-width: 1; mix-blend-mode: multiply; }
  .k-kauen circle { fill: var(--mint); fill-opacity: .45; }
  .k-schlucken circle { fill: var(--teal); fill-opacity: .22; }
  .k-atmen circle { fill: var(--gold); fill-opacity: .38; }
  text { font-family: var(--serif); font-style: italic; font-size: 21px; fill: var(--ink); text-anchor: middle; }
  text.mitte { font-size: 15px; fill: var(--gold-text); }

  @media (prefers-reduced-motion: no-preference) {
    /* Ein Moment: die drei Kreise finden zusammen, danach atmet das Ganze ruhig. */
    .kreis { animation: zusammen 1.8s cubic-bezier(.16, 1, .3, 1) both; }
    .k-kauen { --von: translate(0, -26px); }
    .k-schlucken { --von: translate(-24px, 14px); }
    .k-atmen { --von: translate(24px, 14px); }
    .atmen-ganz { transform-origin: 200px 210px; animation: atmen 7s ease-in-out 1.8s infinite; }
    @keyframes zusammen { from { transform: var(--von); } to { transform: none; } }
    @keyframes atmen { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.025); } }
  }
</style>
