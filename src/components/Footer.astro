---
import { Image } from 'astro:assets';
import logoBlatt from '../assets/logo-blatt.png';
import { praxis } from '../data/site';
import { url } from '../lib/url';
import Gingko from './Gingko.astro';
---
<footer class="fuss">
  <div class="wrap">
    <div>
      <div class="logo"><Image src={logoBlatt} alt="" width={50} height={55} densities={[1, 2]} /><span>Dentosofee</span></div>
      <p>{praxis.untertitel}<br />{praxis.inhaberin}<br />{praxis.beruf}</p>
      <address class="adresse" style="margin-top:12px">{praxis.strasse}, {praxis.plz} {praxis.ort}</address>
    </div>
    <nav aria-label="Angebote">
      <ul>
        <li><a href={url('dentosophie/')}>Dentosophie</a></li>
        <li><a href={url('leistungen/')}>Leistungen</a></li>
        <li><a href={url('preise/')}>Preise</a></li>
        <li><a href={url('ueber-mich/')}>Über mich</a></li>
        <li><a href={url('wissen/')}>Wissen</a></li>
      </ul>
    </nav>
    <nav aria-label="Kontakt und Rechtliches">
      <ul>
        <li><a href={url('kontakt/')}>Kontakt &amp; Buchung</a></li>
        <li><a href={url('impressum/')}>Impressum</a></li>
        <li><a href={url('datenschutz/')}>Datenschutz</a></li>
      </ul>
      <!-- TODO: E-Mail-Adresse noch nicht bestätigt. Bis dahin nur als Text, nicht verlinkt. -->
      <p style="margin-top:14px">E-Mail: {praxis.email}<br />Telefon: {praxis.telefon}</p>
    </nav>
    <div class="disc">
      <p>{praxis.disclaimer}</p>
      <Gingko />
    </div>
  </div>
</footer>
