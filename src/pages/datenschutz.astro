---
import Basis from '../layouts/Basis.astro';
import { praxis, meta } from '../data/site';
// Gerüst. Nur technische Fakten dieser Vorschau, keine erfundenen Rechtstexte. Vor Go-Live anwaltlich prüfen.
---
<Basis titel={meta.datenschutz.titel} beschreibung={meta.datenschutz.beschreibung} brotkrumen={[{ name: 'Datenschutz', pfad: 'datenschutz/' }]}>
  <div class="seitenkopf"><div class="wrap"><h1>Datenschutz</h1></div></div>
  <section class="ohne-oben">
    <div class="wrap text recht">
      <p class="platzhalter">Vorschau: Diese Datenschutzerklärung ist ein Gerüst. Markierte Abschnitte werden vor dem Livegang ergänzt und geprüft.</p>
      <h2>Verantwortliche</h2>
      <p>{praxis.inhaberin}<br />{praxis.strasse}<br />{praxis.plz} {praxis.ort}</p>
      <p class="platzhalter">TODO: Angaben der Verantwortlichen von der Kundin bestätigen.</p>
      <h2>Was diese Website nicht tut</h2>
      <p>Diese Website setzt keine Cookies und verwendet keine Analyse- oder Tracking-Dienste. Die Schriften werden von dieser Website selbst ausgeliefert, es werden keine Schriften von fremden Servern geladen.</p>
      <h2>Hosting</h2>
      <p class="platzhalter">TODO: Angaben zum Hosting (Vorschau: GitHub Pages; Livegang: Hoster von dentosofee.de) ergänzen.</p>
      <h2>Online-Buchung über Calendall</h2>
      <p>Die Terminbuchung erfolgt über den externen Dienst Calendall. Der Link öffnet sich in einem neuen Fenster. Erst dort werden Daten für die Buchung eingegeben.</p>
      <p class="platzhalter">TODO: Angaben zu Calendall (Anbieter, Zweck, Rechtsgrundlage) ergänzen.</p>
      <h2>Deine Rechte</h2>
      <p class="platzhalter">TODO: Rechte der Betroffenen und Beschwerderecht nach anwaltlicher Prüfung ergänzen.</p>
    </div>
  </section>
</Basis>
